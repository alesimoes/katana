# morphology.pt.rules: regras de lematizacao leve para portugues (sem acentos; o texto e dobrado antes de casar).
# suffix <sufixo> <substituicao|-> <tamanho minimo da raiz> <ordem>
#   Casa se a palavra termina em <sufixo> e sobram >= <raiz minima> letras. Regras em ordem crescente de <ordem>
#   (empate: sufixo mais longo primeiro); vale a PRIMEIRA que casa. '-' = substituicao vazia.
#   A substituicao pode ser uma lista separada por virgula (er,ir): candidatos; o consumidor usa o primeiro que existir no vocabulario.
# irregular <forma> <canonica>   (consultado antes das regras; forma ja sem acento)
# O resultado e uma forma de busca (infinitivo/singular), nao um lema linguisticamente perfeito.

# substantivos de acao e derivados -> infinitivo
suffix amentos ar 3 10
suffix amento ar 3 11
suffix imentos er,ir 3 12
suffix imento er,ir 3 13
suffix izacoes izar 3 14
suffix izacao izar 3 15
suffix acoes ar 3 20
suffix acao ar 3 21
suffix ucoes uir 3 22
suffix ucao uir 3 23
suffix icoes ir,er 3 24
suffix icao ir,er 3 25
suffix soes dir 3 26
suffix sao dir 3 27
suffix ssoes tir 3 28
suffix ssao tir 3 29
suffix adores ar 3 30
suffix adoras ar 3 31
suffix adora ar 3 32
suffix ador ar 3 33
suffix edores er 3 34
suffix edor er 3 35
suffix idores ir 3 36
suffix idor ir 3 37
suffix tores tor 2 38
suffix dades dade 3 40
suffix mente - 4 41
suffix ismos ismo 3 42
suffix istas ista 3 43
suffix avel ar 3 44
suffix aveis ar 3 45
suffix ivel er,ir 3 46
suffix iveis er,ir 3 47
suffix osos oso 3 48
suffix osas osa 3 49

# gerundio, participio, formas conjugadas frequentes -> infinitivo
suffix ando ar 3 60
suffix endo er 3 61
suffix indo ir 3 62
suffix ados ar 3 63
suffix adas ar 3 64
suffix ado ar 3 65
suffix ada ar 3 66
suffix idos er,ir 3 67
suffix idas er,ir 3 68
suffix ido er,ir 3 69
suffix ida er,ir 3 70
suffix aram ar 3 71
suffix eram er 3 72
suffix iram ir 3 73
suffix arao ar 3 74
suffix erao er 3 75
suffix irao ir 3 76
suffix ou ar 3 77
suffix aria ar 3 78
suffix asse ar 3 79
suffix amos ar 3 80
suffix emos ar,er 3 81
suffix imos ir 3 82
suffix ava ar 3 83
suffix avam ar 3 84
suffix ar ar 3 85

# plurais
suffix coes cao 3 100
suffix paes pao 2 101
suffix maes mae 2 102
suffix ais al 2 103
suffix eis el 2 104
suffix ois ol 2 105
suffix uis ul 2 106
suffix ns m 2 107
suffix res r 3 108
suffix zes z 3 109
suffix oes ao 2 110
suffix aes ao 2 111
suffix as a 3 112
suffix os o 3 113
suffix es e 3 114
suffix s - 3 115

# feminino / diminutivo / aumentativo
suffix zinhos zinho 3 130
suffix zinho - 3 131
suffix inhos o 3 132
suffix inhas a 3 133
suffix inho o 3 134
suffix inha a 3 135
suffix oes ao 3 136

