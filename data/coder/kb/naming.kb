# naming.kb: padroes de nomes de programacao e o que sugerem sobre a operacao.
# Formato: pattern <glob> <OPERACAO> <papel>
#   glob em snake_case minusculo ('*' qualquer sequencia, '?' um caractere). Nomes camelCase/PascalCase/kebab sao convertidos
#   antes de casar (getUserName -> get_user_name; UserManager -> user_manager).
#   OPERACAO e um ID de operations.kb. papel = o que o nome indica (accessor, mutator, predicate, handler, lifecycle, factory...).
# Varios padroes podem casar o mesmo nome; o consumidor pondera pelo comprimento do trecho fixo do glob.

# acessores, mutadores e predicados
pattern get_* READ accessor
pattern fetch_* READ accessor
pattern find_* READ finder
pattern find_by_* QUERY_DB finder
pattern get_by_* QUERY_DB finder
pattern list_* READ lister
pattern lookup_* READ finder
pattern set_* UPDATE mutator
pattern put_* UPDATE mutator
pattern update_* UPDATE mutator
pattern is_* CHECK_STATE predicate
pattern has_* CHECK_STATE predicate
pattern can_* CHECK_STATE predicate
pattern should_* CHECK_STATE predicate
pattern was_* CHECK_STATE predicate
pattern *_enabled CHECK_STATE predicate
pattern *_exists CHECK_STATE predicate
# eventos e tratadores
pattern on_* EVENT handler
pattern handle_* EVENT handler
pattern emit_* EVENT emitter
pattern fire_* EVENT emitter
pattern dispatch_* EXECUTE dispatcher
pattern trigger_* EVENT emitter
pattern subscribe_* EVENT subscriber
pattern *_handler EVENT handler
pattern *_listener EVENT handler
pattern *_callback EVENT handler
pattern *_cb EVENT handler
# ciclo de vida
pattern init_* INIT lifecycle
pattern initialize_* INIT lifecycle
pattern setup_* INIT lifecycle
pattern bootstrap_* INIT lifecycle
pattern configure_* INIT lifecycle
pattern teardown_* SHUTDOWN lifecycle
pattern cleanup_* SHUTDOWN lifecycle
pattern destroy_* SHUTDOWN lifecycle
pattern shutdown_* SHUTDOWN lifecycle
pattern dispose_* SHUTDOWN lifecycle
pattern *_init INIT lifecycle
pattern *_setup INIT lifecycle
pattern *_cleanup SHUTDOWN lifecycle
# construcao e liberacao
pattern build_* BUILD builder
pattern make_* BUILD factory
pattern create_* CREATE factory
pattern new_* CREATE factory
pattern alloc_* CREATE allocator
pattern free_* SHUTDOWN releaser
pattern release_* SHUTDOWN releaser
pattern delete_* DELETE remover
pattern remove_* DELETE remover
pattern clear_* DELETE remover
# conversao
pattern parse_* PARSE parser
pattern serialize_* CONVERT serializer
pattern deserialize_* CONVERT deserializer
pattern encode_* CONVERT encoder
pattern decode_* CONVERT decoder
pattern to_* CONVERT converter
pattern from_* CONVERT converter
pattern as_* CONVERT converter
pattern format_* CONVERT formatter
# entrada e saida
pattern load_* READ loader
pattern save_* WRITE saver
pattern store_* WRITE saver
pattern open_* INIT opener
pattern close_* SHUTDOWN closer
pattern read_* READ reader
pattern write_* WRITE writer
pattern flush_* WRITE writer
# execucao
pattern start_* EXECUTE starter
pattern stop_* SHUTDOWN stopper
pattern run_* EXECUTE runner
pattern exec_* EXECUTE runner
pattern execute_* EXECUTE runner
pattern process_* EXECUTE processor
pattern perform_* EXECUTE runner
# estruturas de dados
pattern enqueue_* SCHEDULE queue_op
pattern dequeue_* SCHEDULE queue_op
pattern push_* COLLECTION stack_op
pattern pop_* COLLECTION stack_op
pattern append_* COLLECTION list_op
# concorrencia
pattern lock_* LOCK synchronizer
pattern unlock_* LOCK synchronizer
pattern acquire_* LOCK synchronizer
pattern wait_* LOCK synchronizer
pattern *_lock LOCK synchronizer
pattern *_mutex LOCK synchronizer
# testes
pattern test_* TEST test_case
pattern it_* TEST test_case
pattern spec_* TEST test_case
pattern mock_* TEST test_double
pattern stub_* TEST test_double
pattern fake_* TEST test_double
pattern *_test TEST test_case
pattern *_spec TEST test_case
pattern *_fixture TEST fixture
# validacao e erro
pattern validate_* VALIDATE validator
pattern verify_* VALIDATE validator
pattern check_* VALIDATE validator
pattern assert_* VALIDATE validator
pattern ensure_* VALIDATE validator
pattern throw_* ERROR raiser
pattern raise_* ERROR raiser
pattern fail_* ERROR raiser
pattern *_error ERROR error_type
pattern *_exception ERROR error_type
# papeis de classe (sufixos de arquitetura)
pattern *_factory BUILD factory
pattern *_builder BUILD builder
pattern *_manager EXECUTE manager
pattern *_handler EXECUTE handler
pattern *_service EXECUTE service
pattern *_controller NETWORK controller
pattern *_repository QUERY_DB repository
pattern *_dao QUERY_DB repository
pattern *_adapter CONVERT adapter
pattern *_wrapper CONVERT wrapper
pattern *_provider READ provider
pattern *_validator VALIDATE validator
pattern *_converter CONVERT converter
pattern *_parser PARSE parser
pattern *_serializer CONVERT serializer
pattern *_renderer RENDER renderer
pattern *_logger LOG logger
pattern *_scheduler SCHEDULE scheduler
pattern *_worker EXECUTE worker
pattern *_job SCHEDULE job
pattern *_queue SCHEDULE queue
pattern *_cache CACHE cache
pattern *_client NETWORK client
pattern *_server NETWORK server
pattern *_middleware NETWORK middleware
pattern *_observer EVENT observer
pattern *_strategy EXECUTE strategy
pattern *_command EXECUTE command
pattern *_util READ helper
pattern *_utils READ helper
pattern *_helper READ helper
# operacoes de negocio em nomes de funcao
pattern approve_* APPROVE business_action
pattern reject_* REJECT business_action
pattern cancel_* CANCEL business_action
pattern refund_* REFUND business_action
pattern reverse_* REFUND business_action
pattern pay_* PAY business_action
pattern charge_* PAY business_action
pattern invoice_* PAY business_action
pattern reserve_* STOCK_MOVE business_action
pattern notify_* NOTIFY business_action
pattern send_* NOTIFY business_action
pattern sync_* SYNC business_action
pattern retry_* RETRY resilience
pattern schedule_* SCHEDULE scheduler
pattern render_* RENDER renderer
pattern log_* LOG logger
pattern sort_* SORT transformer
pattern filter_* FILTER transformer
pattern sum_* AGGREGATE aggregator
pattern count_* AGGREGATE aggregator
pattern cache_* CACHE cache
pattern login* AUTHENTICATE security
pattern auth_* AUTHENTICATE security
