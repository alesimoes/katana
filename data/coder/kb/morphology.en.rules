# morphology.en.rules: light stemming rules for English (lowercase ASCII). Same format as morphology.pt.rules:
# suffix <suffix> <replacement|-> <minimum stem length> <order>    first matching rule in ascending order wins
# irregular <form> <canonical>                                     checked before the rules
# The replacement may be a comma list of candidates (e,-); the consumer uses the first one found in its vocabulary.

suffix ications ify 3 10
suffix ication ify 3 11
suffix izations ize 3 12
suffix ization ize 3 13
suffix isations ise 3 14
suffix isation ise 3 15
suffix ations ate,e 3 20
suffix ation ate,e 3 21
suffix itions it 3 22
suffix ition it 3 23
suffix utions ute 3 24
suffix ution ute 3 25
suffix isions ide 3 26
suffix ision ide 3 27
suffix essions ess 3 28
suffix ession ess 3 29
suffix ments - 3 30
suffix ment - 3 31
suffix nesses - 3 32
suffix ness - 3 33
suffix ities ity 3 34
suffix ity - 4 35
suffix ables - 3 36
suffix able e,- 3 37
suffix ibles - 3 38
suffix ible e,- 3 39
suffix ously ous 3 40
suffix fully ful 3 41
suffix ally al 3 42
suffix ily y 3 43
suffix ly - 3 44
suffix ers - 3 50
suffix ors or 3 51
suffix er e,- 3 52
suffix or e,- 3 53
suffix ings - 3 60
suffix ing e,- 3 61
suffix ied y 2 70
suffix ies y 2 71
suffix ier y 2 72
suffix iest y 2 73
suffix ed e,- 3 74
suffix es e,- 3 75
suffix ses s 2 76
suffix xes x 2 77
suffix zes z 2 78
suffix ches ch 2 79
suffix shes sh 2 80
suffix ves f,fe 2 81
suffix s - 3 90
suffix ize - 3 100
suffix ise - 3 101
suffix ify - 3 102
suffix ful - 4 103
suffix less - 4 104
suffix ish - 4 105
suffix ous - 4 106
suffix ive - 4 107
suffix al - 4 108
suffix ic - 4 109
suffix est - 4 110
suffix en - 4 111

