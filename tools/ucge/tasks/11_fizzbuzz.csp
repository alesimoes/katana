fn fizzbuzz(n: int) -> list[str]
  let out: list[str] = []
  for i in 1..n + 1
    if i % 15 == 0
      push(out, "FizzBuzz")
    elif i % 3 == 0
      push(out, "Fizz")
    elif i % 5 == 0
      push(out, "Buzz")
    else
      push(out, str(i))
  return out
test fizzbuzz(5) == ["1", "2", "Fizz", "4", "Buzz"]
test len(fizzbuzz(15)) == 15
