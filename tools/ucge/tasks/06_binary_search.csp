# indice de x na lista ordenada, ou -1
fn binarySearch(xs: list[int], x: int) -> int
  let lo = 0
  let hi = len(xs) - 1
  while lo <= hi
    let mid = (lo + hi) // 2
    if xs[mid] == x
      return mid
    elif xs[mid] < x
      lo = mid + 1
    else
      hi = mid - 1
  return -1
test binarySearch([1, 3, 5, 7, 9], 7) == 3
test binarySearch([1, 3, 5, 7, 9], 4) == -1
test binarySearch([], 1) == -1
