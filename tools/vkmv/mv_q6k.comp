#version 450
#extension GL_GOOGLE_include_directive : require
#include "mv_common.glsl"
// Q6 reempacotado: 53 palavras por bloco de 256 pesos: 48 de pesos de 6 bits, 4 de escalas int8, 1 float d
float xv[16];
float QT(uint v, int k) { return float(int(v & 63u) - 32) * xv[k]; }
void main() {
    ini();
    int nb = pc.cols >> 8, bps = nb / NSEG, b0 = sgi * bps;
    uint p[NR];
    for (int r = 0; r < NR; r++) p[r] = rptr(r, nb * 53) + uint(b0) * (53u * 32u);
    int xb = b0 * 256;
    for (int b = 0; b < bps; b++) {
        float acc[NR];
        for (int r = 0; r < NR; r++) acc[r] = 0.0;
        for (int g = 0; g < 4; g++) {
            for (int k = 0; k < 4; k++, xb += 16) {
                for (int u = 0; u < 16; u++) xv[u] = x[xb + u];
                for (int r = 0; r < NR; r++) {
                    uint q = p[r] + uint((g * 4 + k) * 3) * 32u;
                    uint w0 = W[q], w1 = W[q + 32u], w2 = W[q + 64u];
                    int scw = int(W[p[r] + uint(48 + g) * 32u]);
                    float s = QT(w0, 0) + QT(w0 >> 6, 1) + QT(w0 >> 12, 2) + QT(w0 >> 18, 3) + QT(w0 >> 24, 4)
                            + QT((w0 >> 30) | (w1 << 2), 5) + QT(w1 >> 4, 6) + QT(w1 >> 10, 7) + QT(w1 >> 16, 8)
                            + QT(w1 >> 22, 9) + QT((w1 >> 28) | (w2 << 4), 10) + QT(w2 >> 2, 11) + QT(w2 >> 8, 12)
                            + QT(w2 >> 14, 13) + QT(w2 >> 20, 14) + QT(w2 >> 26, 15);
                    acc[r] += float((scw << (24 - 8 * k)) >> 24) * s;
                }
            }
        }
        for (int r = 0; r < NR; r++) { total[r] += uintBitsToFloat(W[p[r] + 52u * 32u]) * acc[r]; p[r] += 53u * 32u; }
    }
    finish();
}
