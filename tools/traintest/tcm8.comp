#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_control_flow_attributes : require
// so medida (tcm_bench): ida Q8_0 com produto int8 x int8 -> int32 por bloco de 32 colunas, vezes a escala do bloco.
// A entrada vem em int8 com escala por vetor: PARTS 1, uma parte (7 bits); 2, duas partes (14 bits), dois produtos.
layout(local_size_x_id = 10) in;
layout(constant_id = 0) const int PARTS = 1;
layout(constant_id = 1) const int BN = 64;
layout(constant_id = 2) const int SN = 2;
const int NT = 4 * SN * 32, CC = BN / SN / 16;
layout(std430, binding = 0) readonly buffer Wb { uint w[]; };
layout(std430, binding = 0) readonly buffer Wb16 { uint16_t w16[]; };
layout(std430, binding = 1) readonly buffer Xb { int8_t x[]; };
layout(std430, binding = 2) writeonly buffer Ob { float o[]; };
layout(std430, binding = 3) readonly buffer Jb { uvec4 j[]; };
layout(push_constant) uniform P { uint M, K, ws, j0, xr; } pc;
shared int8_t As[64 * 72];
shared float Ds[64 * 2 * 16];        // escala por linha e bloco, repetida em 16 colunas
void main() {
    const uint id = gl_LocalInvocationID.x, wr = gl_SubgroupID & 3u, wc = gl_SubgroupID >> 2;
    const uvec4 e = j[pc.j0 + gl_WorkGroupID.y];
    const uint m0 = gl_WorkGroupID.x * 64u, n0 = wc * uint(CC) * 16u;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[CC];
    [[unroll]] for (uint c = 0u; c < CC; c++) acc[c] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    for (uint k0 = 0u; k0 < pc.K; k0 += 64u) {
        for (uint u = id; u < 512u; u += NT) {
            const uint rr = u >> 3, wi = u & 7u, b = ((e.x + (m0 + rr) * pc.ws) >> 1) + ((k0 >> 5) + (wi >> 2)) * 17u;
            [[unroll]] for (uint t = 0u; t < 4u; t++) {
                const uint v = uint(w16[b + 1u + (wi & 3u) * 4u + t]);
                As[rr * 72u + wi * 8u + 2u * t] = int8_t(int(v << 24) >> 24);
                As[rr * 72u + wi * 8u + 2u * t + 1u] = int8_t(int(v << 16) >> 24);
            }
            const float d = unpackHalf2x16(uint(w16[b])).x;
            [[unroll]] for (uint t = 0u; t < 4u; t++) Ds[((wi >> 2) * 64u + rr) * 16u + (wi & 3u) * 4u + t] = d;
        }
        barrier();
        [[unroll]] for (uint q = 0u; q < 2u; q++) {
            coopmat<int8_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA> a;
            coopMatLoad(a, As, wr * 16u * 72u + q * 32u, 72, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> s;
            coopMatLoad(s, Ds, (q * 64u + wr * 16u) * 16u, 16, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint c = 0u; c < CC; c++) {
                coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB> b;
                coopMatLoad(b, x, (e.y + n0 + c * 16u) * pc.K + k0 + q * 32u, pc.K, gl_CooperativeMatrixLayoutColumnMajor);
                coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> p = coopMatMulAdd(a, b, coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0));
                if (PARTS > 1) {
                    coopMatLoad(b, x, (pc.xr + e.y + n0 + c * 16u) * pc.K + k0 + q * 32u, pc.K, gl_CooperativeMatrixLayoutColumnMajor);
                    p = coopMatMulAdd(a, b, p * 128);
                }
                const coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> pf = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(p);
                acc[c] = acc[c] + pf * s;
            }
        }
        barrier();
    }
    [[unroll]] for (uint c = 0u; c < CC; c++)
        coopMatStore(acc[c], o, (e.z + n0 + c * 16u) * pc.M + m0 + wr * 16u, pc.M, gl_CooperativeMatrixLayoutColumnMajor);
}
