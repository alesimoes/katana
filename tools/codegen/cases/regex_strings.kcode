fn t(s: str, rx: str) -> bool
  return matches(s, rx)
fn run() -> int
  let pats = ["^a.c$", "a+b", "[0-9]{3}-[0-9]{2}", "^\\d+$", "(ab|cd)+e", "x*", "^$", "\\bfoo\\b", "colou?r", "[^a-c]x", "a{2,3}", "(?:ab){2}", "^[A-Za-z_]\\w*$", ".*z$", "a.*?b", "[a-]b", "\\.com$", "^(a|ab)(c|bcd)$"]
  let subs = ["abc", "aaab", "123-45", "12345", "ababcde", "", "foo bar", "a foo b", "color", "colour", "dx", "aax", "aaaa", "abab", "_ident9", "xyz", "axxb", "a-b", "site.com", "abcd"]
  for p in pats
    let line = p + " =>"
    for s in subs
      if t(s, p)
        line += " " + str(len(s))
      else
        line += " ."
    print(line)
  print(slice("hello", -3))
  print(slice("hello", 1, -1))
  print(slice("hello", 10))
  print(slice("hello", -100, 2))
  print(slice([1, 2, 3, 4], -2))
  print(slice([1, 2, 3, 4], 1, 3))
  print("hello"[-1])
  print("hello"[0])
  print(replace("aaa", "a", "bb"))
  print(replace("abc", "", "-"))
  print(split("a,b,,c,", ","))
  print(words("  a  bb \t c\n"))
  print(join(["x", "y", "z"], ", "))
  print(upper("MiXed 1") + lower("MiXed 1"))
  print(trim("  pad \n"))
  print(indexof("hello", "l"))
  print(indexof("hello", "z"))
  print(startswith("hello", "he"))
  print(endswith("hello", "lo"))
  print("b" in "abc")
  print("z" in "abc")
  print("a" < "b")
  print("Z" < "a")
  print("abc" < "abd")
  print("ab" < "abc")
  print(reverse("abc"))
  print(str(3) + str(2.5) + str(true) + str(1e20) + str(1.5e-7) + str(100.0) + str(0.1))
  print(1e16)
  print(123456789.123)
  print(float("2.50") + 1)
  print(int("  42 ") + int("-7"))
  print(int(3.99))
  print(int(-3.99))
  print(floor(-3.5))
  print(sqrt(16.0))
  print(pow(2, 10))
  print(abs(-7) + abs(-2))
  print(7 // 2)
  print(-7 // 2)
  print(7 // -2)
  print(-7 % 3)
  print(7 % -3)
  print(10 / 4)
  print(min(3, 9))
  print(max(3, 9))
  return 0
test run() == 0
