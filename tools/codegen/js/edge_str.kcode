# strings (unicode), listas, mapas
fn main() -> int
  let s = "añb世🙂c"
  print(str(len(s)) + " " + str(indexof(s, "c")) + " " + str(indexof(s, "世")) + " " + str(indexof(s, "zz")) + " " + reverse(s))
  print(s[0] + s[3] + s[4] + s[-1] + s[-2])
  print(slice(s, 2) + "|" + slice(s, 1, 4) + "|" + slice(s, -3) + "|" + slice(s, 0, -1) + "|" + slice(s, 10) + "|" + slice(s, -99, 2))
  print(upper("straße é") + " " + lower("ÀÉÎ SS") + " [" + trim("  \t x y \n ") + "] [" + trim("  z") + "]")
  print(str(words("  a  bb\tccc \n d ")) + " " + str(split("a,b,,c", ",")) + " " + str(split("", ",")) + " " + str(len(words("   "))))
  print(join(["x", "y", "z"], "-") + " " + join([], "-") + "|" + replace("aaa", "a", "bb") + "|" + replace("abc", "", "-") + "|" + replace("", "", "-") + "|" + replace("x$y", "$", "$&"))
  print(str(contains("hello", "ell")) + " " + str(startswith("hello", "he")) + " " + str(endswith("hello", "lo")) + " " + str("a" in "banana") + " " + str("🙂" in s))
  print(str("a" < "b") + " " + str("Z" < "a") + " " + str("🙂" < "￮") + " " + str("abc" < "abd") + " " + str("" < "a") + " " + str("b" <= "b") + " " + str("é" > "z"))
  print(str(matches("abc123", "[a-z]+[0-9]+")) + " " + str(matches("abc", "^[0-9]+$")))
  try
    print(s[10])
  catch e
    print("index error: " + errmsg(e))
  try
    print(str(split("abc", "")))
  catch e2
    print("split error: " + errmsg(e2))
  let xs = [5, 3, 9, 1]
  print(str(xs[-1]) + " " + str(xs[0]) + " " + str(len(xs)) + " " + str(sort(xs)) + " " + str(xs) + " " + str(reverse(xs)) + " " + str(xs) + " " + str(slice(xs, 1, 3)) + " " + str(slice(xs, -2)))
  push(xs, 7)
  xs[0] = 50
  xs[-1] += 1
  print(str(xs) + " " + str(pop(xs)) + " " + str(xs))
  try
    xs[9] = 1
  catch e3
    print("put error: " + errmsg(e3))
  try
    print(str(xs[-9]))
  catch e4
    print("get error: " + errmsg(e4))
  let empty: list[int] = []
  try
    print(str(pop(empty)))
  catch e5
    print("pop error: " + errmsg(e5))
  print(str(sort(["b", "a", "🙂", "￮", "B"])) + " " + str(sort([2.5, -1.0, 2.0])) + " " + str([1, 2] == [1, 2]) + " " + str([[1], [2]] == [[1], [3]]) + " " + str(3 in xs) + " " + str(50 in xs))
  let m = {"b": 1, "a": 2, "10": 3, "2": 4}
  m["z"] = 9
  m["a"] += 5
  print(str(keys(m)) + " " + str(len(m)) + " " + str(m) + " " + str(contains(m, "a")) + " " + str("q" in m))
  for k, v in m
    print(k + "->" + str(v))
  for k2 in m
    print(k2)
  try
    print(str(m["nope"]))
  catch e6
    print("key error: " + errmsg(e6))
  let nested = {"k": [1, 2, 3], "j": []}
  print(str(nested))
  let t = 0
  for ch in "añ世🙂"
    t += 1
    print(ch)
  print(str(t))
  print(str([1.5, 2.0]) + " " + str(["it's", "say \"hi\"", "a\nb", "tab\t"]) + " " + str(true) + " " + str(null))
  return 0
test main() == 0
