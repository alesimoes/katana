#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

/* ---- vkgemm_mobile/tiled_int8dp.comp: ladrilho + produto inteiro empacotado (VK_KHR_shader_integer_dot_product) ----
   Mesma organizacao de ladrilho do tiled_vec.comp (memoria compartilhada, 256 threads, micro-ladrilho
   4x4 por thread), mas a entrada e int8 empacotado (4 valores por palavra de 32 bits) e o produto interno
   de 4 em 4 usa a instrucao dedicada (dotPacked4x8EXT), em vez de 4 multiplicacoes fp16 escalares. Layout
   DIFERENTE do tiled_vec.comp: aqui as duas entradas (pesos e ativacao) ficam no mesmo formato "linha por
   K" (cada uma com o lote de 4 valores de K empacotado), porque a instrucao de produto exige os 4 valores
   de K consecutivos nos DOIS operandos - por isso a ativacao nao fica transposta aqui como no caso fp16. */
layout(local_size_x = 256) in;

const uint BM = 64, BN = 64, BK = 32, BK4 = BK / 4;
const uint TM = 4, TN = 4;
const uint TX = BN / TN, TY = BM / TM;

layout(set = 0, binding = 0) readonly buffer WB { uint w[]; } wb;   // w[row*(cols/4) + k4]: 4 int8 de W, empacotados ao longo de K
layout(set = 0, binding = 1) readonly buffer XB { uint x[]; } xb;   // x[tok*(cols/4) + k4]: 4 int8 de X (mesma linha de K), por token
layout(set = 0, binding = 2) writeonly buffer YB { int y[]; } yb;   // acumulador inteiro (sem escala: o chamador confere contra a CPU nos mesmos inteiros)
layout(push_constant) uniform PC { uint rows, cols, tokens; } pc;

shared uint buf_a[BM * BK4];   // buf_a[r*BK4+k4]
shared uint buf_b[BN * BK4];   // buf_b[t*BK4+k4] (por token, nao transposto)

void main() {
    const uint ir = gl_WorkGroupID.x * BM, ic = gl_WorkGroupID.y * BN;
    const uint id = gl_LocalInvocationID.x;
    const uint ty = id / TX, tx = id % TX;

    int acc[TM][TN];
    for (uint i = 0; i < TM; i++) for (uint j = 0; j < TN; j++) acc[i][j] = 0;

    const uint cols4 = pc.cols / 4;
    for (uint k0 = 0; k0 < pc.cols; k0 += BK) {
        const uint na = BM * BK4;
        for (uint i = id; i < na; i += 256) {
            const uint r = i / BK4, k4 = i % BK4;
            buf_a[i] = wb.w[(ir + r) * cols4 + k0 / 4 + k4];
        }
        const uint nb = BN * BK4;
        for (uint i = id; i < nb; i += 256) {
            const uint t = i / BK4, k4 = i % BK4;
            buf_b[i] = xb.x[(ic + t) * cols4 + k0 / 4 + k4];
        }
        barrier();
        [[dont_unroll]] for (uint k4 = 0; k4 < BK4; k4++) {
            int ra[TM], rb[TN];
            for (uint i = 0; i < TM; i++) ra[i] = int(buf_a[(ty * TM + i) * BK4 + k4]);
            for (uint j = 0; j < TN; j++) rb[j] = int(buf_b[(tx * TN + j) * BK4 + k4]);
            for (uint i = 0; i < TM; i++) for (uint j = 0; j < TN; j++) acc[i][j] += dotPacked4x8EXT(ra[i], rb[j]);
        }
        barrier();
    }
    for (uint i = 0; i < TM; i++) for (uint j = 0; j < TN; j++)
        yb.y[(ir + ty * TM + i) * pc.tokens + ic + tx * TN + j] = acc[i][j];
}
