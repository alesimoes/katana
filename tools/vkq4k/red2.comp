#version 450
// soma as fatias de K: out[i] = (add ? out[i] : 0) + soma_z part[z*slice + i]
layout(local_size_x = 256) in;
layout(set = 0, binding = 1) readonly buffer PB { float p[]; } pb;
layout(set = 0, binding = 2) buffer OB { float o[]; } ob;
layout(push_constant) uniform PC { uint n, splits, slice, add; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float a = pc.add != 0u ? ob.o[i] : 0.0;
    for (uint z = 0; z < pc.splits; z++) a += pb.p[z * pc.slice + i];
    ob.o[i] = a;
}
