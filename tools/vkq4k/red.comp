#version 450
// soma as fatias de K: out[i] = soma_z part[z*slice4 + i]  (em vec4)
layout(local_size_x = 256) in;
layout(set = 0, binding = 1) readonly buffer PB { vec4 p[]; } pb;
layout(set = 0, binding = 2) buffer OB { vec4 o[]; } ob;
layout(push_constant) uniform PC { uint n4, splits, slice4; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n4) return;
    vec4 a = vec4(0.0);
    for (uint z = 0; z < pc.splits; z++) a += pb.p[z * pc.slice4 + i];
    ob.o[i] = a;
}
