    "// operacoes dinamicas (operandos any): so existem quando o tipo nao foi dado; o erro de tipo e em tempo de execucao",
    "func cgArith(op int, a, b any) any {",
    "\tai, aok := a.(int64)",
    "\tbi, bok := b.(int64)",
    "\tif ab, ok := a.(bool); ok {",
    "\t\tai, aok = 0, true",
    "\t\tif ab {",
    "\t\t\tai = 1",
    "\t\t}",
    "\t}",
    "\tif bb, ok := b.(bool); ok {",
    "\t\tbi, bok = 0, true",
    "\t\tif bb {",
    "\t\t\tbi = 1",
    "\t\t}",
    "\t}",
    "\tif aok && bok {",
    "\t\tswitch op {",
    "\t\tcase 0:",
    "\t\t\treturn cgAdd(ai, bi)",
    "\t\tcase 1:",
    "\t\t\treturn cgSub(ai, bi)",
    "\t\tcase 2:",
    "\t\t\treturn cgMul(ai, bi)",
    "\t\tcase 3:",
    "\t\t\treturn cgFDiv(float64(ai), float64(bi))",
    "\t\tcase 4:",
    "\t\t\treturn cgIDiv(ai, bi)",
    "\t\t}",
    "\t\treturn cgMod(ai, bi)",
    "\t}",
    "\tif cgIsNum(a) && cgIsNum(b) {",
    "\t\tx, y := cgNumF(a), cgNumF(b)",
    "\t\tswitch op {",
    "\t\tcase 0:",
    "\t\t\treturn x + y",
    "\t\tcase 1:",
    "\t\t\treturn x - y",
    "\t\tcase 2:",
    "\t\t\treturn x * y",
    "\t\tcase 3:",
    "\t\t\treturn cgFDiv(x, y)",
    "\t\tcase 4:",
    "\t\t\treturn math.Floor(cgFDiv(x, y))",
    "\t\t}",
    "\t\treturn cgFMod(x, y)",
    "\t}",
    "\tif op == 0 {",
    "\t\tif x, ok := a.(string); ok {",
    "\t\t\tif y, ok := b.(string); ok {",
    "\t\t\t\treturn x + y",
    "\t\t\t}",
    "\t\t}",
    "\t\tif x, ok := a.(Lister); ok {",
    "\t\t\tif y, ok := b.(Lister); ok {",
    "\t\t\t\tr := &List[any]{}",
    "\t\t\t\tfor i := 0; i < x.Len(); i++ {",
    "\t\t\t\t\tr.a = append(r.a, x.AnyAt(i))",
    "\t\t\t\t}",
    "\t\t\t\tfor i := 0; i < y.Len(); i++ {",
    "\t\t\t\t\tr.a = append(r.a, y.AnyAt(i))",
    "\t\t\t\t}",
    "\t\t\t\treturn r",
    "\t\t\t}",
    "\t\t}",
    "\t}",
    "\tcgThrow(\"type error: unsupported operand types \" + cgTName(a) + \" and \" + cgTName(b))",
    "\treturn nil",
    "}",
