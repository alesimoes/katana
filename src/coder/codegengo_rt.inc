    "func cgEq(a, b any) bool {",
    "\tif a == nil || b == nil {",
    "\t\treturn a == nil && b == nil",
    "\t}",
    "\tif cgIsNum(a) && cgIsNum(b) {",
    "\t\tai, aok := a.(int64)",
    "\t\tbi, bok := b.(int64)",
    "\t\tif aok && bok {",
    "\t\t\treturn ai == bi",
    "\t\t}",
    "\t\treturn cgNumF(a) == cgNumF(b)",
    "\t}",
    "\tswitch x := a.(type) {",
    "\tcase string:",
    "\t\ty, ok := b.(string)",
    "\t\treturn ok && x == y",
    "\tcase Lister:",
    "\t\ty, ok := b.(Lister)",
    "\t\tif !ok || x.Len() != y.Len() {",
    "\t\t\treturn false",
    "\t\t}",
    "\t\tfor i := 0; i < x.Len(); i++ {",
    "\t\t\tif !cgEq(x.AnyAt(i), y.AnyAt(i)) {",
    "\t\t\t\treturn false",
    "\t\t\t}",
    "\t\t}",
    "\t\treturn true",
    "\tcase Mapper:",
    "\t\ty, ok := b.(Mapper)",
    "\t\tif !ok || x.Len() != y.Len() {",
    "\t\t\treturn false",
    "\t\t}",
    "\t\tfor i := 0; i < x.Len(); i++ {",
    "\t\t\tif !y.HasKey(x.KeyAt(i)) || !cgEq(x.AnyValAt(i), y.AnyGet(x.KeyAt(i))) {",
    "\t\t\t\treturn false",
    "\t\t\t}",
    "\t\t}",
    "\t\treturn true",
    "\t}",
    "\treturn a == b",
    "}",
    "func cgCmp(a, b any) int {",
    "\tif cgIsNum(a) && cgIsNum(b) {",
    "\t\tai, aok := a.(int64)",
    "\t\tbi, bok := b.(int64)",
    "\t\tif aok && bok {",
    "\t\t\tswitch {",
    "\t\t\tcase ai < bi:",
    "\t\t\t\treturn -1",
    "\t\t\tcase ai > bi:",
    "\t\t\t\treturn 1",
    "\t\t\t}",
    "\t\t\treturn 0",
    "\t\t}",
    "\t\tx, y := cgNumF(a), cgNumF(b)",
    "\t\tswitch {",
    "\t\tcase x < y:",
    "\t\t\treturn -1",
    "\t\tcase x > y:",
    "\t\t\treturn 1",
    "\t\t}",
    "\t\treturn 0",
    "\t}",
    "\tx, ok1 := a.(string)",
    "\ty, ok2 := b.(string)",
    "\tif ok1 && ok2 {",
    "\t\treturn strings.Compare(x, y)",
    "\t}",
    "\tcgThrow(\"type error: cannot order \" + cgTName(a) + \" and \" + cgTName(b))",
    "\treturn 0",
    "}",
    "func cgFmt(b *strings.Builder, v any, rep bool) {",
    "\tswitch x := v.(type) {",
    "\tcase nil:",
    "\t\tb.WriteString(\"None\")",
    "\tcase bool:",
    "\t\tb.WriteString(cgBStr(x))",
    "\tcase int64:",
    "\t\tb.WriteString(strconv.FormatInt(x, 10))",
    "\tcase float64:",
    "\t\tb.WriteString(cgFStr(x))",
    "\tcase string:",
    "\t\tif rep {",
    "\t\t\tb.WriteString(cgSRep(x))",
    "\t\t} else {",
    "\t\t\tb.WriteString(x)",
    "\t\t}",
    "\tcase Lister:",
    "\t\tb.WriteByte('[')",
    "\t\tfor i := 0; i < x.Len(); i++ {",
    "\t\t\tif i > 0 {",
    "\t\t\t\tb.WriteString(\", \")",
    "\t\t\t}",
    "\t\t\tcgFmt(b, x.AnyAt(i), true)",
    "\t\t}",
    "\t\tb.WriteByte(']')",
    "\tcase Mapper:",
    "\t\tb.WriteByte('{')",
    "\t\tfor i := 0; i < x.Len(); i++ {",
    "\t\t\tif i > 0 {",
    "\t\t\t\tb.WriteString(\", \")",
    "\t\t\t}",
    "\t\t\tb.WriteString(cgSRep(x.KeyAt(i)))",
    "\t\t\tb.WriteString(\": \")",
    "\t\t\tcgFmt(b, x.AnyValAt(i), true)",
    "\t\t}",
    "\t\tb.WriteByte('}')",
    "\tdefault:",
    "\t\tb.WriteString(\"<object>\")",
    "\t}",
    "}",
    "func cgStr(v any) string {",
    "\tif s, ok := v.(string); ok {",
    "\t\treturn s",
    "\t}",
    "\tvar b strings.Builder",
    "\tcgFmt(&b, v, false)",
    "\treturn b.String()",
    "}",
    "func cgPrint(v any) { fmt.Println(cgStr(v)) }",
