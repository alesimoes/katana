    "                if (n->lazy) { r = cg_rm(n->next, p, len, i) || cg_rm(n->a, p, len, i); }",
    "                else { r = cg_rm(n->a, p, len, i) || cg_rm(n->next, p, len, i); }",
    "                n->mark = saved; return r;",
    "            }",
    "        }",
    "        return 0;",
    "    }",
    "}",
    "static inline int cg_matches(CgStr s, CgStr re) {                  /* re.search: acha o padrao em qualquer posicao */",
    "    long long i;",
    "    s = cg_snn(s); re = cg_snn(re);",
    "    if (!cg_rcache || cg_rcp != re.p || cg_rcn != re.n) {",
    "        CgRp r; CgRt *t; CgRn *end = cg_rn(CR_END, NULL);",
    "        r.p = re.p; r.n = re.n; r.i = 0; t = cg_ralt(&r);",
    "        if (r.i < r.n) cg_throw(CG_S(\"regex: unbalanced )\"));",
    "        cg_rcache = cg_rbuild(t, end); cg_rcp = re.p; cg_rcn = re.n;",
    "    }",
    "    cg_rsteps = 0;",
    "    for (i = 0; i <= s.n; i++) if (cg_rm((CgRn *)cg_rcache, s.p, s.n, i)) return 1;",
    "    return 0;",
    "}",
    NULL};
