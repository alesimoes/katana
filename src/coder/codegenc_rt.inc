    "/* operacoes dinamicas (operandos any): so existem quando o tipo nao foi dado; o erro de tipo e em tempo de execucao */",
    "static inline CgV cg_varith(int op, CgV a, CgV b) {            /* op: 0 + 1 - 2 * 3 / 4 // 5 % */",
