#version 450
// d[i] += prm[0]  (valor por submissao vindo de buffer pequeno)
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer D { float d[]; };
layout(std430, binding = 1) readonly buffer Q { float prm[]; };
layout(push_constant) uniform P { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i < p.n) d[i] += prm[0]; }
