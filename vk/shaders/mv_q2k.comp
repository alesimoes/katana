#version 450
#extension GL_GOOGLE_include_directive : require
#include "mv_common.glsl"
// Q2_K cru: 21 palavras por bloco de 256 pesos: 4 de escalas (byte: 4 bits escala, 4 bits minimo),
// 16 de pesos de 2 bits, 1 com d e dmin (float16). Grupo g (16 pesos) = c*8 + j*2 + h:
// bytes q[c*32 + h*16 + l] deslocados de 2*j; posicao c*128 + j*32 + h*16 + l.
void main() {
    ini();
    int nb = pc.cols >> 8, bps = nb / NSEG, b0 = sgi * bps;
    uint p[NR];
    for (int r = 0; r < NR; r++) p[r] = rptr(r, nb * 21) + uint(b0) * (21u * 32u);
    int xb = b0 * 256;
    float xv[16];
    for (int b = 0; b < bps; b++, xb += 256) {
        float aq[NR], am[NR];
        for (int r = 0; r < NR; r++) { aq[r] = 0.0; am[r] = 0.0; }
        for (int g = 0; g < 16; g++) {
            int c = g >> 3, j = (g >> 1) & 3, h = g & 1;
            int xo = xb + c * 128 + j * 32 + h * 16;
            float sx = 0.0;
            for (int u = 0; u < 16; u++) { xv[u] = x[xo + u]; sx += xv[u]; }
            for (int r = 0; r < NR; r++) {
                uint sc = (W[p[r] + uint(g >> 2) * 32u] >> (8 * (g & 3))) & 255u;
                float s = 0.0;
                for (int k = 0; k < 4; k++) {
                    uint w = W[p[r] + uint(4 + c * 8 + h * 4 + k) * 32u] >> (2 * j);
                    s += float(w & 3u) * xv[4 * k] + float((w >> 8) & 3u) * xv[4 * k + 1]
                       + float((w >> 16) & 3u) * xv[4 * k + 2] + float((w >> 24) & 3u) * xv[4 * k + 3];
                }
                aq[r] += float(sc & 15u) * s;
                am[r] += float(sc >> 4) * sx;
            }
        }
        for (int r = 0; r < NR; r++) {
            vec2 dm = h2(W[p[r] + 20u * 32u]);
            total[r] += dm.x * aq[r] - dm.y * am[r];
            p[r] += 21u * 32u;
        }
    }
    finish();
}
