#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
/* qwen4exp, um token: O[oofs + r] = W[r] . X, com os pesos no formato do GGUF reempacotados so para alinhar em 32 bits.
   Um subgrupo (32 faixas) faz uma linha; a faixa e o elemento dentro de cada grupo de 32, entao as leituras de W e de X do
   subgrupo caem em enderecos seguidos (medido: com uma faixa por bloco de 256, cada leitura ia a uma linha de cache diferente).
   WT: 12 Q4_K, 13 Q5_K, 14 Q6_K (212 bytes), 21 IQ3_S (112 bytes, a escala ganhou 2 bytes), 23 IQ4_XS, 30 BF16.
   A conta de cada formato e a do dequant da CPU, em float32. */
layout(local_size_x = 256) in;
layout(constant_id = 0) const int WT = 30;
layout(std430, binding = 0) readonly buffer Wb { uint W[]; };
layout(std430, binding = 1) readonly buffer Xb { float X[]; };
layout(std430, binding = 2) writeonly buffer Ob { float O[]; };
layout(std430, binding = 3) readonly buffer Gb { uint GR[]; };      /* grade do IQ3_S */
layout(push_constant) uniform P { int rows, rw, oofs, cols; } pc;   /* rw: palavras por linha */

const uint NL[4] = uint[4](0xBFAD9881u, 0xF6EADDCFu, 0x26190D01u, 0x71594535u);      /* -127, -104, ... 113 (tabela do IQ4) */
uint byt(int base, int i) { return (W[base + (i >> 2)] >> (8 * (i & 3))) & 255u; }
ivec2 k4sm(int b, int j) {      /* escala e minimo de 6 bits do sub-bloco j */
    if (j < 4) return ivec2(int(byt(b, j) & 63u), int(byt(b, j + 4) & 63u));
    const uint hi = byt(b, j + 4);
    return ivec2(int((hi & 15u) | ((byt(b, j - 4) >> 6) << 4)), int((hi >> 4) | ((byt(b, j) >> 6) << 4)));
}
int nl(uint c) { return bitfieldExtract(int(NL[c >> 2]), int(8u * (c & 3u)), 8); }
void main() {
    const int e = int(gl_SubgroupInvocationID), row = int(gl_WorkGroupID.x) * int(gl_NumSubgroups) + int(gl_SubgroupID);
    if (row >= pc.rows) return;
    const int w0 = row * pc.rw;
    float s = 0.0;
    if (WT == 30) {
        for (int i = e; i < pc.cols; i += 32) {
            const uint u = W[w0 + (i >> 1)];
            s += uintBitsToFloat((i & 1) != 0 ? u & 0xffff0000u : u << 16) * X[i];
        }
    } else if (WT == 12 || WT == 13) {
        const int bw = WT == 13 ? 44 : 36, q0 = WT == 13 ? 12 : 4;
        for (int b = 0, w = w0; b * 256 < pc.cols; b++, w += bw) {
            const vec2 dm = unpackHalf2x16(W[w]);
            const uint h = WT == 13 ? byt(w + 4, e) : 0u;
            for (int j = 0; j < 8; j += 2) {
                const uint v = byt(w + q0, 16 * j + e);
                const uint lo = (v & 15u) | (((h >> j) & 1u) << 4), hi = (v >> 4) | (((h >> (j + 1)) & 1u) << 4);
                const ivec2 a = k4sm(w + 1, j), c = k4sm(w + 1, j + 1);
                s += (dm.x * float(a.x * int(lo)) - dm.y * float(a.y)) * X[b * 256 + 32 * j + e];
                s += (dm.x * float(c.x * int(hi)) - dm.y * float(c.y)) * X[b * 256 + 32 * j + 32 + e];
            }
        }
    } else if (WT == 14) {
        const int h = e >> 4;
        for (int b = 0, w = w0; b * 256 < pc.cols; b++, w += 53) {
            float t = 0.0;
            for (int c = 0; c < 2; c++) {
                const uint l0 = byt(w, 64 * c + e), l1 = byt(w, 64 * c + 32 + e), hv = byt(w + 32, 32 * c + e);
                const int x = b * 256 + 128 * c + e;
                const uint su = W[w + 48 + 2 * c], sv = W[w + 49 + 2 * c];      /* 8 escalas com sinal */
                t += float(bitfieldExtract(int(su), 8 * h, 8) * (int((l0 & 15u) | ((hv & 3u) << 4)) - 32)) * X[x];
                t += float(bitfieldExtract(int(su), 16 + 8 * h, 8) * (int((l1 & 15u) | (((hv >> 2) & 3u) << 4)) - 32)) * X[x + 32];
                t += float(bitfieldExtract(int(sv), 8 * h, 8) * (int((l0 >> 4) | (((hv >> 4) & 3u) << 4)) - 32)) * X[x + 64];
                t += float(bitfieldExtract(int(sv), 16 + 8 * h, 8) * (int((l1 >> 4) | ((hv >> 6) << 4)) - 32)) * X[x + 96];
            }
            s += unpackHalf2x16(W[w + 52]).x * t;
        }
    } else if (WT == 23) {
        for (int b = 0, w = w0; b * 256 < pc.cols; b++, w += 34) {
            const uint sh = W[w] >> 16, sc4 = W[w + 1];
            float t = 0.0;
            for (int ib = 0; ib < 8; ib++) {
                const int sc = int(((sc4 >> (4 * ib)) & 15u) | (((sh >> (2 * ib)) & 3u) << 4)) - 32;
                const uint v = byt(w + 2, 16 * ib + (e & 15));
                t += float(sc * nl(e < 16 ? v & 15u : v >> 4)) * X[b * 256 + 32 * ib + e];
            }
            s += unpackHalf2x16(W[w]).x * t;
        }
    } else if (WT == 20) {          /* IQ4_NL: 32 pesos em 20 bytes (escala alinhada) */
        for (int g = 0, w = w0; g * 32 < pc.cols; g++, w += 5) {
            const uint v = byt(w + 1, e & 15);
            s += unpackHalf2x16(W[w]).x * float(nl(e < 16 ? v & 15u : v >> 4)) * X[g * 32 + e];
        }
    } else if (WT == 42) {          /* Q2_0: 64 pesos em 20 bytes */
        for (int g = 0, w = w0; g * 32 < pc.cols; g++) {
            const int k = (g & 1) * 32 + e;
            s += unpackHalf2x16(W[w]).x * float(int((W[w + 1 + (k >> 4)] >> (2 * (k & 15))) & 3u) - 1) * X[g * 32 + e];
            if ((g & 1) != 0) w += 5;
        }
    } else {
        for (int b = 0, w = w0; b * 256 < pc.cols; b++, w += 28) {
            const uint q0 = W[w + 17], q1 = W[w + 18], sc4 = W[w + 27];
            float t = 0.0;
            for (int g = 0; g < 8; g++) {
                const int l = e >> 2;
                const uint id = byt(w + 1, 8 * g + l) | ((((g < 4 ? q0 : q1) >> (8 * (g & 3) + l)) & 1u) << 8);
                const int v = int((GR[id] >> (8 * (e & 3))) & 255u);
                const int sc = int(1u + 2u * ((sc4 >> (4 * g)) & 15u));
                t += float(((W[w + 19 + g] >> e) & 1u) != 0u ? -sc * v : sc * v) * X[b * 256 + 32 * g + e];
            }
            s += unpackHalf2x16(W[w]).x * t;
        }
    }
    s = subgroupAdd(s);
    if (e == 0) O[pc.oofs + row] = s;
}
