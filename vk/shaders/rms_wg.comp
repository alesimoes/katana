#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
/* RMSNorm alternativa (melhoria Vulkan): um grupo de 256 threads por token; cada thread soma uma fatia
   estriada dos quadrados, subgroupAdd reduz dentro do subgrupo e uma memoria local minuscula junta os subgrupos.
   Custo O(n) por token em vez de O(n*n) do kernel fiel (que refaz a soma em cada coluna). Mesmos buffers e push. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer G { float g[]; };
layout(std430, binding = 2) buffer O { float o[]; };
layout(push_constant) uniform P { int n; float eps; int B; } pc;
shared float part[32];
void main() {
    int b = int(gl_WorkGroupID.x), l = int(gl_LocalInvocationID.x), B = pc.B;
    float s = 0.0;
    for (int j = l; j < pc.n; j += 256) { float v = x[j * B + b]; s += v * v; }
    s = subgroupAdd(s);
    if (gl_SubgroupInvocationID == 0u) part[gl_SubgroupID] = s;
    barrier();
    float tot = 0.0;
    int nsg = (256 + int(gl_SubgroupSize) - 1) / int(gl_SubgroupSize);
    for (int k = 0; k < nsg; k++) tot += part[k];
    float inv = 1.0 / sqrt(tot / float(pc.n) + pc.eps);
    for (int i = l; i < pc.n; i += 256) o[i * B + b] = g[i] * (x[i * B + b] * inv);
}
