#version 450
// COOP=1 (padrao): produto no passo final por matriz cooperativa (coopMatLoad/coopMatMulAdd/coopMatStore).
// COOP=0: sem matriz cooperativa (celular sem VK_KHR_cooperative_matrix) - mesmo ladrilho decodificado por
// fill(), mas o produto 16x16x16 e feito por registro bloqueado escalar (tools/vkgemm_mobile/tiled_vec.comp,
// medido ~4,1x sobre o caminho ingenuo no Xclipse 540); so vale com BR=1, WS=0, XS=0 (gen.sh so gera essa
// combinacao para as variantes _tiled).
#ifndef COOP
#define COOP 1
#endif
#if COOP
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#endif
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require

// Y[rows][tokens] = W[rows][cols] * X[cols][tokens], pesos quantizados no layout do katana,
// decodificados ao encher o ladrilho compartilhado; matrizes cooperativas fp16 x fp16 -> fp32.
// Parametros de compilacao: WT (0 Q4_K, 1 Q6_K, 2 Q5_K, 3 Q8_0, 4 F32, 5 Q5_1 exato), BM, BN, SM x SN subgrupos,
// XF32 (ativacoes fp32 lidas direto), XS (com XF32: ativacao em duas partes fp16, alta + resto, dois produtos
// sobre o mesmo ladrilho de pesos; precisao de ~22 bits na ativacao), WS (peso decodificado em duas partes fp16, alta +
// resto: sem WS o peso perde ~2,4e-4 relativo no arredondamento), SCTAB (tabela de escala/minimo em memoria compartilhada), GLU (gate/up).
#ifndef SCTAB
#define SCTAB 0
#endif
#ifndef GLU
#define GLU 0
#endif
#ifndef XF32
#define XF32 0
#endif
#ifndef XS
#define XS 0
#endif
#ifndef WS
#define WS 0
#endif
// os restos guardam (x - fp16(x)) * LS: sem a escala eles cairiam na faixa subnormal do fp16 (pesos ~1e-2 deixam
// restos ~5e-6) e perderiam bits; os produtos com restos acumulam a parte e entram vezes 1/LS no fim
#define LS 2048.0
// parte alta = x com a mantissa cortada em 10 bits (exata em fp16), por mascara de bits: a ida e volta
// float16_t(float(x)), ou por packHalf2x16, o compilador do driver dobra para x e o resto virava zero
float hi16(float x) { return uintBitsToFloat(floatBitsToUint(x) & 0xFFFFE000u); }
float16_t lo16(float x) { return float16_t((x - hi16(x)) * LS); }
#if WS
#define PUTA(i, val) { const float wv_ = (val); buf_a[i] = float16_t(hi16(wv_)); buf_w[i] = lo16(wv_); }
#else
#define PUTA(i, val) buf_a[i] = float16_t(val)
#endif
#define NSG (SM * SN)
#define NT (NSG * 32)
layout(local_size_x = NT) in;
#ifndef KS
#define KS 1
#endif
#ifndef DB
#define DB 0
#endif
#ifndef BR
#define BR 0
#endif
#if !COOP && !BR
#error "COOP=0 so suporta BR=1 (sem matriz cooperativa: tools/vkgemm_mobile/tiled_vec.comp)"
#endif
#if !COOP
#define TR 4      // saidas por lane no ladrilho 16x16 (registro bloqueado): GR*TR = GC*TC = T, GR*GC = 32
#define TC 2
#endif
const uint BK = 64 * KS, T = 16;
const uint WM = BM / SM, WN = BN / SN;
const uint CR = WM / T, CC = WN / T;
#ifndef PADA
#define PADA 8
#endif
#ifndef PADB
#define PADB 8
#endif
const uint STRIDE = BK + PADA;

layout(set = 0, binding = 0) readonly buffer WB { uint w[]; } wb;       // entrelacado de 32 em 32 linhas
#if XF32
layout(set = 0, binding = 1) readonly buffer XB { float x[]; } xb;
layout(set = 0, binding = 1) readonly buffer XB4 { vec4 x4[]; } xb4;
#else
layout(set = 0, binding = 1) readonly buffer XB { float16_t x[]; } xb;
layout(set = 0, binding = 1) readonly buffer XB4 { f16vec4 x4[]; } xb4;
#endif
#ifndef YH
#define YH 0
#endif
#if YH
layout(set = 0, binding = 2) buffer YB { float16_t y[]; } yb;            // y[row*tokens + token] em fp16 (so modo GLU)
#else
layout(set = 0, binding = 2) buffer YB { float y[]; } yb;                // y[row*tokens + token]
#endif
layout(push_constant) uniform PC { uint rows, cols, tokens, wpr, kper, slice, add, woff; } pc;   // woff: deslocamento em palavras dos pesos

#if BR
const uint STRB = BN + PADB;                 // B na memoria compartilhada: uma linha por coluna k (RowMajor)
#define BSZ (BK * STRB)
#else
#define BSZ (BN * STRIDE)
#endif
shared float16_t buf_a[(1 + DB) * BM * STRIDE];
#if WS
shared float16_t buf_w[(1 + DB) * BM * STRIDE];   // resto do peso: w - fp16(w)
#endif
shared float16_t buf_b[(1 + DB) * BSZ];
#if XS
shared float16_t buf_r[(1 + DB) * BSZ];        // resto da ativacao: x - fp16(x)
#endif
#if GLU
#define SCRN 512
#else
#define SCRN 256
#endif
shared float scr[NSG * SCRN];
#if SCTAB
shared float tab[BM * 17];
#endif

#define SB(k) ((hw[(k) >> 2] >> (((k) & 3) * 8)) & 255u)
void scmin(uint hw[3], uint j, out uint sc, out uint mn) {
    if (j < 4) { sc = SB(j) & 63; mn = SB(j + 4) & 63; }
    else { sc = (SB(j + 4) & 15) | ((SB(j - 4) >> 6) << 4); mn = (SB(j + 4) >> 4) | ((SB(j) >> 6) << 4); }
}

// linha do ladrilho compartilhado do slot h (grupo de 32 linhas) e linha r0 dentro dele
uint srow(uint h, uint r0) {
#if GLU
    const uint HW = WM / 2, o = 32 * (h >> 1) + r0;     // gate e up da mesma linha ficam no mesmo subgrupo
    return o + (o / HW) * HW + (h & 1) * HW;
#else
    return 32 * h + r0;
#endif
}

void fill(uint kk, uint ao, uint bo) {
    const uint id = gl_LocalInvocationID.x;
#if GLU
    const uint ir = gl_WorkGroupID.x * (BM / 2);
#else
    const uint ir = gl_WorkGroupID.x * BM;
#endif
    const uint ic = gl_WorkGroupID.y * BN;
    const uint tokens = pc.tokens;
#ifdef FORCEVEC
    const bool vec4ok = true;
#else
    const bool vec4ok = (tokens & 3u) == 0u;
#endif
        // ---- A: decodifica os pesos (unidade = 16 pesos de uma linha)
        for (uint ks = 0; ks < KS; ks++)
        for (uint i = 0; i < BM * 4 / NT; i++) {
            const uint k0 = kk + 64 * ks, blk = k0 / 256, s = (k0 % 256) / 64;
            const uint u = id + i * NT, r0 = u & 31, gi = (u >> 5) & 3, h = u >> 7;
            const uint sr = srow(h, r0), o = ao + sr * STRIDE + 64 * ks + gi * 16;
#if GLU
            const uint G = ((ir >> 5) + (h >> 1)) * 2 + (h & 1), gr = ((ir >> 5) + (h >> 1)) * 32;
#else
            const uint G = (ir >> 5) + h, gr = G * 32;
#endif
            const uint wbase = G * pc.wpr * 32 + r0 + pc.woff;
            if (gr >= pc.rows) {
                for (uint t = 0; t < 16; t++) buf_a[o + t] = float16_t(0.0);
#if WS
                for (uint t = 0; t < 16; t++) buf_w[o + t] = float16_t(0.0);
#endif
                continue;
            }
#if WT == 0 || WT == 2
            {
                const uint base = wbase + blk * (WT == 0 ? 36 : 44) * 32;
                float dsc[2], dm[2];
#if SCTAB
                for (uint v = 0; v < 2; v++) { dsc[v] = tab[sr * 17 + (2 * s + v) * 2]; dm[v] = tab[sr * 17 + (2 * s + v) * 2 + 1]; }
#else
                const uint h0 = wb.w[base];
                uint hw[3] = uint[3](wb.w[base + 32], wb.w[base + 64], wb.w[base + 96]);
                const float d = unpackHalf2x16(h0).x, dmin = unpackHalf2x16(h0).y;
                for (uint v = 0; v < 2; v++) {
                    uint sc, mn; scmin(hw, 2 * s + v, sc, mn);
                    dsc[v] = d * float(sc); dm[v] = dmin * float(mn);
                }
#endif
                for (uint v = 0; v < 2; v++) {
                    const uint l = gi * 2 + v;
                    const uint oo = ao + sr * STRIDE + 64 * ks + l * 4;
#if WT == 0
                    const uint wd = wb.w[base + (4 + s * 8 + l) * 32];
                    for (uint b = 0; b < 4; b++) {
                        PUTA(oo + b, dsc[0] * float((wd >> (8 * b)) & 15) - dm[0]);
                        PUTA(oo + 32 + b, dsc[1] * float((wd >> (8 * b + 4)) & 15) - dm[1]);
                    }
#else
                    const uint wd = wb.w[base + (12 + s * 8 + l) * 32], hb = wb.w[base + (4 + l) * 32] >> (2 * s);
                    for (uint b = 0; b < 4; b++) {
                        PUTA(oo + b, dsc[0] * float(((wd >> (8 * b)) & 15) | (((hb >> (8 * b)) & 1) << 4)) - dm[0]);
                        PUTA(oo + 32 + b, dsc[1] * float(((wd >> (8 * b + 4)) & 15) | (((hb >> (8 * b + 1)) & 1) << 4)) - dm[1]);
                    }
#endif
                }
            }
#elif WT == 1
            {
                const uint base = wbase + blk * 53 * 32;
                const float d = uintBitsToFloat(wb.w[base + 52 * 32]);
                const int scw = int(wb.w[base + (48 + s) * 32]);
                const float dsc = d * float((scw << (24 - 8 * int(gi))) >> 24);
                const uint q = base + (s * 4 + gi) * 3 * 32;
                const uint w0 = wb.w[q], w1 = wb.w[q + 32], w2 = wb.w[q + 64];
                for (uint t = 0; t < 16; t++) {
                    const uint bit = 6 * t, wi = bit / 32, off = bit % 32;
                    uint v = (wi == 0 ? w0 : (wi == 1 ? w1 : w2)) >> off;
                    if (off > 26) v |= (wi == 0 ? w1 : w2) << (32 - off);
                    PUTA(o + t, dsc * float(int(v & 63) - 32));
                }
            }
#elif WT == 3
            {
                const uint base = wbase + ((k0 >> 5) + (gi >> 1)) * 9 * 32;
                const float d = uintBitsToFloat(wb.w[base]);
                for (uint v = 0; v < 4; v++) {
                    const uint wd = wb.w[base + (1 + (gi & 1) * 4 + v) * 32];
                    for (uint b = 0; b < 4; b++) {
                        const float wf = d * float(int(wd << (24 - 8 * b)) >> 24);
                        PUTA(o + v * 4 + b, wf);
                    }
                }
            }
#elif WT == 5
            {   // Q5_1 exato, 6 palavras: escala e minimo fp16, quinto bit, 4 palavras de 4 bits; peso = d*q + m
                const uint base = wbase + ((k0 >> 5) + (gi >> 1)) * 6 * 32;
                const vec2 dm = unpackHalf2x16(wb.w[base]);
                const uint hb = wb.w[base + 32] >> (16 * (gi & 1));
                for (uint v = 0; v < 2; v++) {
                    const uint wd = wb.w[base + (2 + (gi & 1) * 2 + v) * 32];
                    for (uint b = 0; b < 8; b++) {
                        const float wf = dm.x * float(((wd >> (4 * b)) & 15u) | (((hb >> (8 * v + b)) & 1u) << 4)) + dm.y;
                        PUTA(o + v * 8 + b, wf);
                    }
                }
            }
#else
            for (uint t = 0; t < 16; t++) {
                const float wf = uintBitsToFloat(wb.w[wbase + (k0 + gi * 16 + t) * 32]);
                PUTA(o + t, wf);
            }
#endif
        }
        // ---- B: ativacoes (tokens fora do lote viram zero)
        if (vec4ok) {
            for (uint i = 0; i < BK * BN / 4 / NT; i++) {
                const uint idx = id + i * NT, c = idx / (BN / 4), n = (idx % (BN / 4)) * 4;
#if XF32
                vec4 v = vec4(0.0);
#else
                f16vec4 v = f16vec4(0.0);
#endif
                if (ic + n < tokens) v = xb4.x4[((kk + c) * tokens + ic + n) / 4];
#if BR
                const uint ob = bo + c * STRB + n;
#if XS
                buf_b[ob] = float16_t(hi16(v.x)); buf_b[ob + 1] = float16_t(hi16(v.y)); buf_b[ob + 2] = float16_t(hi16(v.z)); buf_b[ob + 3] = float16_t(hi16(v.w));
#else
                buf_b[ob] = float16_t(v.x); buf_b[ob + 1] = float16_t(v.y); buf_b[ob + 2] = float16_t(v.z); buf_b[ob + 3] = float16_t(v.w);
#endif
#if XS
                buf_r[ob] = lo16(v.x); buf_r[ob + 1] = lo16(v.y);
                buf_r[ob + 2] = lo16(v.z); buf_r[ob + 3] = lo16(v.w);
#endif
#else
                buf_b[bo + n * STRIDE + c] = float16_t(v.x); buf_b[bo + (n + 1) * STRIDE + c] = float16_t(v.y);
                buf_b[bo + (n + 2) * STRIDE + c] = float16_t(v.z); buf_b[bo + (n + 3) * STRIDE + c] = float16_t(v.w);
#endif
            }
        } else {
            for (uint i = 0; i < BK * BN / NT; i++) {
                const uint idx = id + i * NT, c = idx / BN, n = idx % BN;
                float16_t v = float16_t(0.0);
#if XS
                float xf = 0.0;
                if (ic + n < tokens) xf = xb.x[(kk + c) * tokens + ic + n];
                v = float16_t(hi16(xf));
                buf_r[bo + c * STRB + n] = lo16(xf);
#else
                if (ic + n < tokens) v = float16_t(xb.x[(kk + c) * tokens + ic + n]);
#endif
#if BR
                buf_b[bo + c * STRB + n] = v;
#else
                buf_b[bo + n * STRIDE + c] = v;
#endif
            }
        }
}

void main() {
    const uint id = gl_LocalInvocationID.x;
#if COOP
    const uint warp = gl_SubgroupID, lane = gl_SubgroupInvocationID;
#else
    // sem matriz cooperativa (Xclipse 540): ladrilho logico de 32 "lanes", independente do tamanho real
    // do subgrupo do driver (64 nesse aparelho) - cada lane cobre TR x TC saidas do bloco 16x16 em
    // registradores (mesma tecnica de tools/vkgemm_mobile/tiled_vec.comp, sobre o ladrilho ja decodificado
    // por fill()). barrier() substitui subgroupBarrier() abaixo: sincroniza o workgroup todo, nao so o
    // subgrupo real, mas e sempre correto (so um pouco mais conservador).
    const uint warp = id / 32, lane = id % 32;
    const uint GC = T / TC, trg = lane / GC, tcg = lane % GC;
#endif
    const uint wr = warp % SM, wc = warp / SM;
#if GLU
    const uint ir = gl_WorkGroupID.x * (BM / 2);
#else
    const uint ir = gl_WorkGroupID.x * BM;
#endif
    const uint ic = gl_WorkGroupID.y * BN;
#if COOP
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> acc[CR * CC];
    for (uint i = 0; i < CR * CC; i++) acc[i] = coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
#if XS || WS
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> acl[CR * CC];     // produtos com os restos (vezes LS)
    for (uint i = 0; i < CR * CC; i++) acl[i] = coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
#endif
#else
    float accs[CR * CC][TR][TC];
    for (uint i = 0; i < CR * CC; i++) for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++) accs[i][a][b] = 0.0;
#if XS || WS
    float accl[CR * CC][TR][TC];      // produtos com os restos (vezes LS), igual ao acl[] do caminho coopMat
    for (uint i = 0; i < CR * CC; i++) for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++) accl[i][a][b] = 0.0;
#endif
#endif
    const uint kb = gl_WorkGroupID.z * pc.kper, ke = min(pc.cols, kb + pc.kper);
    const uint tokens = pc.tokens;
    #ifdef FORCEVEC
    const bool vec4ok = true;
#else
    const bool vec4ok = (tokens & 3u) == 0u;
#endif
#if DB
    fill(kb, 0, 0);
    barrier();
    uint cur = 0;
#endif
    for (uint k0 = kb; k0 < ke; k0 += BK) {
#if DB
        const uint ao = cur * (BM * STRIDE), bo = cur * BSZ;
        if (k0 + BK < ke) fill(k0 + BK, (cur ^ 1) * (BM * STRIDE), (cur ^ 1) * BSZ);
        cur ^= 1;
#else
        const uint ao = 0, bo = 0;
#endif
        const uint blk = k0 / 256, s = (k0 % 256) / 64;
#if SCTAB
        if ((k0 & 255u) == 0u) {
            for (uint i = 0; i < BM * 8 / NT; i++) {
                const uint e = id + i * NT, j = e & 7, rest = e >> 3, r0 = rest & 31, h = rest >> 5;
#if GLU
                const uint G = ((ir >> 5) + (h >> 1)) * 2 + (h & 1), gr = ((ir >> 5) + (h >> 1)) * 32;
#else
                const uint G = (ir >> 5) + h, gr = G * 32;
#endif
                float a = 0.0, b = 0.0;
                if (gr < pc.rows) {
                    const uint base = G * pc.wpr * 32 + r0 + pc.woff + blk * (WT == 0 ? 36 : 44) * 32;
                    const uint h0 = wb.w[base];
                    uint hw[3] = uint[3](wb.w[base + 32], wb.w[base + 64], wb.w[base + 96]);
                    uint sc, mn; scmin(hw, j, sc, mn);
                    a = unpackHalf2x16(h0).x * float(sc); b = unpackHalf2x16(h0).y * float(mn);
                }
                const uint sr = srow(h, r0);
                tab[sr * 17 + j * 2] = a; tab[sr * 17 + j * 2 + 1] = b;
            }
            barrier();
        }
#endif
        fill(k0, ao, bo);
#if !DB
        barrier();
#endif
#if COOP
        for (uint k = 0; k < BK; k += T) {
            for (uint cr = 0; cr < CR; cr++) {
                coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> a;
                coopMatLoad(a, buf_a, ao + (wr * WM + cr * T) * STRIDE + k, STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#if WS
                coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> aw;
                coopMatLoad(aw, buf_w, ao + (wr * WM + cr * T) * STRIDE + k, STRIDE, gl_CooperativeMatrixLayoutRowMajor);
#endif
                for (uint cc = 0; cc < CC; cc++) {
                    coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> b;
#if BR
                    coopMatLoad(b, buf_b, bo + k * STRB + wc * WN + cc * T, STRB, gl_CooperativeMatrixLayoutRowMajor);
#else
                    coopMatLoad(b, buf_b, bo + (wc * WN + cc * T) * STRIDE + k, STRIDE, gl_CooperativeMatrixLayoutColumnMajor);
#endif
                    acc[cc * CR + cr] = coopMatMulAdd(a, b, acc[cc * CR + cr]);
#if WS
                    acl[cc * CR + cr] = coopMatMulAdd(aw, b, acl[cc * CR + cr]);
#endif
#if XS
                    coopMatLoad(b, buf_r, bo + k * STRB + wc * WN + cc * T, STRB, gl_CooperativeMatrixLayoutRowMajor);
                    acl[cc * CR + cr] = coopMatMulAdd(a, b, acl[cc * CR + cr]);
#endif
                }
            }
        }
#else
        // mesmo ladrilho 16x16x16 que o coopMat faria, mas por registro bloqueado (TR x TC por lane):
        // cada lane cobre linhas locais {trg*TR..trg*TR+TR-1} x colunas locais {tcg*TC..tcg*TC+TC-1}
        // do bloco T x T, somando sobre kk - exatamente a soma que coopMatMulAdd faria nesse bloco.
        for (uint k = 0; k < BK; k += T) {
            for (uint cr = 0; cr < CR; cr++) {
                const uint arow0 = ao + (wr * WM + cr * T + trg * TR) * STRIDE + k;
                for (uint cc = 0; cc < CC; cc++) {
                    const uint bcol0 = bo + k * STRB + wc * WN + cc * T + tcg * TC;
                    [[dont_unroll]] for (uint kk = 0; kk < T; kk++) {
                        float ra[TR], rb[TC];
                        for (uint a = 0; a < TR; a++) ra[a] = float(buf_a[arow0 + a * STRIDE + kk]);
                        for (uint b = 0; b < TC; b++) rb[b] = float(buf_b[bcol0 + b + kk * STRB]);
                        for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++) accs[cc * CR + cr][a][b] += ra[a] * rb[b];
#if WS
                        {       // peso em duas partes (alta ja somada acima, resto aqui): mesmo par de ativacao rb
                            float raw[TR];
                            for (uint a = 0; a < TR; a++) raw[a] = float(buf_w[arow0 + a * STRIDE + kk]);
                            for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++) accl[cc * CR + cr][a][b] += raw[a] * rb[b];
                        }
#endif
#if XS
                        {       // ativacao em duas partes (alta ja somada acima, resto aqui): mesmo peso ra (parte alta)
                            float rbr[TC];
                            for (uint b = 0; b < TC; b++) rbr[b] = float(buf_r[bcol0 + b + kk * STRB]);
                            for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++) accl[cc * CR + cr][a][b] += ra[a] * rbr[b];
                        }
#endif
                    }
                }
            }
        }
#endif
        barrier();
    }
    // ---- epilogue
#if XS || WS
#if COOP
    for (uint i = 0; i < CR * CC; i++) acc[i] = acc[i] + acl[i] * (1.0 / LS);
#else
    for (uint i = 0; i < CR * CC; i++) for (uint a = 0; a < TR; a++) for (uint b = 0; b < TC; b++)
        accs[i][a][b] = accs[i][a][b] + accl[i][a][b] * (1.0 / LS);
#endif
#endif
    const uint yz = gl_WorkGroupID.z * pc.slice;
#if !GLU
    if (pc.add == 0u && vec4ok && ir + BM <= pc.rows && ic + BN <= tokens) {
#if COOP
        [[unroll]] for (uint cr = 0; cr < CR; cr++)
            [[unroll]] for (uint cc = 0; cc < CC; cc++)
                coopMatStore(acc[cc * CR + cr], yb.y, yz + (ir + wr * WM + cr * T) * tokens + ic + wc * WN + cc * T, tokens,
                             gl_CooperativeMatrixLayoutRowMajor);
#else
        [[unroll]] for (uint cr = 0; cr < CR; cr++)
            [[unroll]] for (uint cc = 0; cc < CC; cc++)
                [[unroll]] for (uint a = 0; a < TR; a++)
                    [[unroll]] for (uint b = 0; b < TC; b++)
                        yb.y[yz + (ir + wr * WM + cr * T + trg * TR + a) * tokens + ic + wc * WN + cc * T + tcg * TC + b]
                            = accs[cc * CR + cr][a][b];
#endif
        return;
    }
#endif
#ifdef NOSCR
    return;
#endif
    const uint sb = warp * SCRN;
#if GLU
    [[unroll]] for (uint cr = 0; cr < CR / 2; cr++)
        [[unroll]] for (uint cc = 0; cc < CC; cc++) {
#if COOP
            coopMatStore(acc[cc * CR + cr], scr, sb, T, gl_CooperativeMatrixLayoutRowMajor);
            coopMatStore(acc[cc * CR + cr + CR / 2], scr, sb + 256, T, gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared(); subgroupBarrier();
#else
            [[unroll]] for (uint a = 0; a < TR; a++)
                [[unroll]] for (uint b = 0; b < TC; b++) {
                    scr[sb + (trg * TR + a) * T + tcg * TC + b] = accs[cc * CR + cr][a][b];
                    scr[sb + 256 + (trg * TR + a) * T + tcg * TC + b] = accs[cc * CR + cr + CR / 2][a][b];
                }
            barrier();
#endif
            for (uint e = lane; e < 256; e += 32) {
                const uint row = ir + wr * (WM / 2) + cr * T + e / 16, tok = ic + wc * WN + cc * T + e % 16;
                if (row < pc.rows && tok < tokens) {
                    const float g = scr[sb + e], up = scr[sb + 256 + e];
                    // bit 1 de add: GELU (tanh), como o feed-forward do gemma4; senao SiLU
                    const float ga = (pc.add & 2u) != 0u ? 0.5 * g * (1.0 + tanh(clamp(0.7978845608 * (g + 0.044715 * g * g * g), -15.0, 15.0)))
                                                         : g / (1.0 + exp(-g));
                    float v = ga * up;
                    const uint ix = yz + row * tokens + tok;
#if YH
                    yb.y[ix] = float16_t(v);
#else
                    if ((pc.add & 1u) != 0u) v += yb.y[ix];
                    yb.y[ix] = v;
#endif
                }
            }
#if COOP
            subgroupMemoryBarrierShared(); subgroupBarrier();
#else
            barrier();
#endif
        }
#else
    [[unroll]] for (uint cr = 0; cr < CR; cr++)
        [[unroll]] for (uint cc = 0; cc < CC; cc++) {
#if COOP
            coopMatStore(acc[cc * CR + cr], scr, sb, T, gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared(); subgroupBarrier();
#else
            [[unroll]] for (uint a = 0; a < TR; a++)
                [[unroll]] for (uint b = 0; b < TC; b++)
                    scr[sb + (trg * TR + a) * T + tcg * TC + b] = accs[cc * CR + cr][a][b];
            barrier();
#endif
            for (uint e = lane; e < 256; e += 32) {
                const uint row = ir + wr * WM + cr * T + e / 16, tok = ic + wc * WN + cc * T + e % 16;
                if (row < pc.rows && tok < tokens) {
                    float v = scr[sb + e];
                    const uint ix = yz + row * tokens + tok;
                    if (pc.add != 0u) v += yb.y[ix];
                    yb.y[ix] = v;
                }
            }
#if COOP
            subgroupMemoryBarrierShared(); subgroupBarrier();
#else
            barrier();
#endif
        }
#endif
}
