#version 450
#extension GL_GOOGLE_include_directive : require
#include "mv_common.glsl"
// Q8: 9 palavras por bloco de 32 pesos: escala float + 32 int8
void main() {
    ini();
    int nb = pc.cols >> 5, bps = nb / NSEG, b0 = sgi * bps;
    uint p[NR];
    for (int r = 0; r < NR; r++) p[r] = rptr(r, nb * 9) + uint(b0) * (9u * 32u);
    int xb = b0 * 32;
    for (int b = 0; b < bps; b++, xb += 32) {
        float a[NR];
        for (int r = 0; r < NR; r++) a[r] = 0.0;
        for (int l = 0; l < 8; l++) {
            float x0 = x[xoff_ + xb + 4 * l], x1 = x[xoff_ + xb + 4 * l + 1], x2 = x[xoff_ + xb + 4 * l + 2], x3 = x[xoff_ + xb + 4 * l + 3];
            for (int r = 0; r < NR; r++) {
                int w = int(W[p[r] + uint(1 + l) * 32u]);
                a[r] += float((w << 24) >> 24) * x0 + float((w << 16) >> 24) * x1
                      + float((w << 8) >> 24) * x2 + float(w >> 24) * x3;
            }
        }
        for (int r = 0; r < NR; r++) { total[r] += uintBitsToFloat(W[p[r]]) * a[r]; p[r] += 9u * 32u; }
    }
    finish();
}
