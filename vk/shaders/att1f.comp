#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
/* Atencao inteira de um token num lancamento (um grupo de hd threads por cabeca; local_size_x = hd por
   spec constant 0): bias/norma de q e k, RoPE, gravacao de k e v no cache, notas, softmax, mistura.
   Threads 0..hd/2-1 giram um par de q; hd/2..hd-1 giram um par de k da cabeca kv. A posicao atual usa k e v
   locais (cache lido so para t < pos); so a primeira cabeca de cada grupo kv grava no cache.
   Contexto dividido (split-K): o lancamento tem nh * nchunk grupos (y = pedaco); o pedaco c cobre as posicoes
   [c*chunk, (c+1)*chunk). Cada pedaco refaz a rotacao de q e k (barata), calcula notas/softmax/mistura so do seu
   trecho e grava em part o resultado sem normalizar + maximo + soma; att1r junta os pedacos. Com nchunk == 1 grava a
   saida normalizada direto em o e nao precisa de att1r. Pedacos vazios gravam maximo -3e38 e soma 0. */
layout(local_size_x_id = 0) in;
layout(std430, binding = 0) readonly buffer QS { float qs[]; };
layout(std430, binding = 1) readonly buffer KS { float ks_[]; };
layout(std430, binding = 2) readonly buffer VS { float vs[]; };
layout(std430, binding = 3) readonly buffer BQ { float bq[]; };
layout(std430, binding = 4) readonly buffer BK { float bk[]; };
layout(std430, binding = 5) readonly buffer BV { float bv[]; };
layout(std430, binding = 6) buffer KC { KVT kc[]; };
layout(std430, binding = 7) buffer VC { KVT vc[]; };
layout(std430, binding = 8) buffer A { float att[]; };
layout(std430, binding = 9) buffer O { float o[]; };
layout(std430, binding = 10) readonly buffer FR { float freq[]; };
layout(std430, binding = 11) readonly buffer QN { float qn[]; };
layout(std430, binding = 12) readonly buffer KN { float kn[]; };
layout(std430, binding = 14) buffer PT { float part[]; };   /* [(h*nchunk + c)*(hd+2)]: o nao normalizado, maximo, soma */
layout(std430, binding = 13) readonly buffer MT { int meta[]; };   /* meta[0] = posicao do token (muda por token) */
layout(push_constant) uniform P { int base, ctx, hd, kvd, group, neox, has_bias, norm, d; float scale, eps; int chunk, nchunk, nrot, qst, gate; } pc;
shared float lm[256]; shared float lq[256]; shared float lk[256];
void main() {
    int hd = pc.hd, kvd = pc.kvd, pos = meta[0], group = pc.group;
    int h = int(gl_WorkGroupID.x), l = int(gl_LocalInvocationID.x), T = pos + 1, g = h / group, half_ = hd / 2;
    int off = pc.base + pos * kvd + g * hd;
    int a = h * pc.ctx;
    const int c0 = int(gl_WorkGroupID.y), t0 = c0 * pc.chunk, t1 = min(T, t0 + pc.chunk);
    if (t0 >= T) {
        if (l == 0) { part[(h * pc.nchunk + c0) * (hd + 2) + hd] = -3.0e38; part[(h * pc.nchunk + c0) * (hd + 2) + hd + 1] = 0.0; }
        part[(h * pc.nchunk + c0) * (hd + 2) + l] = 0.0;
        return;
    }
    {
        bool isk = l >= half_;
        int i = isk ? l - half_ : l;
        /* RoPE parcial (neox): pares (i, i+nrot/2) para i < nrot/2; as dims >= nrot nao giram (2 por thread) */
        const int hr = pc.nrot / 2;
        int i0, i1; float cs = 1.0, sn = 0.0;
        if (pc.neox == 0) { i0 = 2 * i; i1 = i0 + 1; rope_cs(float(pos) * freq[i], cs, sn); }
        else if (i < hr) { i0 = i; i1 = i + hr; rope_cs(float(pos) * freq[i], cs, sn); }
        else { i0 = pc.nrot + 2 * (i - hr); i1 = i0 + 1; }
        if (isk) {
            float x0 = ks_[g * hd + i0], x1 = ks_[g * hd + i1];
            if ((pc.has_bias & 2) != 0) { x0 += bk[g * hd + i0]; x1 += bk[g * hd + i1]; }
            if (pc.norm != 0) {
                int r0 = pc.norm == 1 ? 0 : g * hd, len = pc.norm == 1 ? kvd : hd;
                float ss = 0.0; for (int j = 0; j < len; j++) { float t = ks_[r0 + j]; ss += t * t; }
                float inv = 1.0 / sqrt(ss / float(len) + pc.eps);
                x0 *= kn[g * hd + i0 - r0] * inv; x1 *= kn[g * hd + i1 - r0] * inv;
            }
            float y0 = x0 * cs - x1 * sn, y1 = x0 * sn + x1 * cs;
            lk[i0] = y0; lk[i1] = y1;
            if (c0 == 0 && h % group == 0) { KVS(y0, off + i0, kc); KVS(y1, off + i1, kc); }
        } else {
            const int qb = h * pc.qst;
            float x0 = qs[qb + i0], x1 = qs[qb + i1];
            if ((pc.has_bias & 1) != 0) { x0 += bq[h * hd + i0]; x1 += bq[h * hd + i1]; }
            if (pc.norm != 0) {
                int r0 = pc.norm == 1 ? 0 : qb, len = pc.norm == 1 ? pc.d : hd, w0 = pc.norm == 1 ? h * hd : 0;
                float ss = 0.0; for (int j = 0; j < len; j++) { float t = qs[r0 + j]; ss += t * t; }
                float inv = 1.0 / sqrt(ss / float(len) + pc.eps);
                x0 *= qn[w0 + i0] * inv; x1 *= qn[w0 + i1] * inv;
            }
            lq[i0] = x0 * cs - x1 * sn; lq[i1] = x0 * sn + x1 * cs;
        }
    }
    float vl = vs[g * hd + l] + (((pc.has_bias & 4) != 0) ? bv[g * hd + l] : 0.0);
    if (c0 == 0 && h % group == 0) KVS(vl, off + l, vc);
    barrier();
    float mx = -3.0e38;
    for (int t = t0 + l; t < t1; t += hd) {
        float s = 0.0;
        if (t == pos) { for (int j = 0; j < hd; j++) s += lq[j] * lk[j]; }
        else { int kh = pc.base + t * kvd + g * hd;
            for (int j = 0; j < hd; j++) s += lq[j] * KVL(kc, kh + j); }
        s *= pc.scale; att[a + t] = s; mx = max(mx, s);
    }
    lm[l] = mx;
    barrier();
    float gm = lm[0];
    for (int k = 1; k < hd; k++) gm = max(gm, lm[k]);
    barrier();
    float sum = 0.0;
    for (int t = t0 + l; t < t1; t += hd) { float e = exp(att[a + t] - gm); att[a + t] = e; sum += e; }
    lm[l] = sum;
    memoryBarrierBuffer();
    barrier();
    float tot = 0.0;
    for (int k = 0; k < hd; k++) tot += lm[k];
    int v = pc.base + g * hd + l;
    float s = (pos >= t0 && pos < t1) ? att[a + pos] * vl : 0.0;
    for (int t = t0; t < min(t1, pos); t++) s += att[a + t] * KVL(vc, v + t * kvd);
    if (pc.gate != 0) s *= 1.0 / (1.0 + exp(-qs[h * pc.qst + hd + l]));   /* portao da saida (linear: vale por pedaco) */
    if (pc.nchunk == 1) { o[h * hd + l] = s / tot; return; }
    const int pb = (h * pc.nchunk + c0) * (hd + 2);
    part[pb + l] = s;
    if (l == 0) { part[pb + hd] = gm; part[pb + hd + 1] = tot; }
}
