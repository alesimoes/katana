#version 450
// d[i] += c  (no lugar). local_size_x vem da spec constant 0
layout(local_size_x_id = 0, local_size_x = 64) in;
layout(std430, binding = 0) buffer D { float d[]; };
layout(push_constant) uniform P { float c; uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i < p.n) d[i] += p.c; }
